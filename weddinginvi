        :root {
            --ivory: #fcfaf5;
            --paper: #fffefa;
            --gold: #b7934a;
            --deep-gold: #8a682f;
            --ink: #4a3b28;
            --soft-gold: #f5ecd8;
            --line: rgba(183, 147, 74, .36);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            width: 100%;
            margin: 0;
            overflow-x: hidden;
            font-family: "Alegreya", serif;
            color: var(--ink);
        }

        .display-font {
            font-family: "Playfair Display", serif;
        }

        .entry-screen {
            min-height: calc(100 * min(var(--vh, 1vh), 1vh));
            position: fixed;
            inset: 0;
            z-index: 40;
            display: grid;
            place-items: center;
            padding: 20px;
            overflow: hidden;
            background:
                radial-gradient(circle at 50% 24%, rgba(255, 248, 210, .96) 0%, rgba(255, 248, 210, .32) 18%, transparent 42%),
                linear-gradient(145deg, #6c5127 0%, #b7934a 45%, #e8d4a1 100%);
            transition: opacity .8s ease, visibility .8s ease;
        }

        .entry-screen::before,
        .entry-screen::after {
            content: "";
            position: absolute;
            width: 72vmax;
            height: 72vmax;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, .2);
            animation: halo 4.5s ease-in-out infinite;
        }

        .entry-screen::after {
            width: 48vmax;
            height: 48vmax;
            animation-delay: -2s;
        }

        .entry-screen.is-open {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .light-ray {
            position: absolute;
            width: 35%;
            height: 150%;
            top: -25%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 244, .44), transparent);
            filter: blur(7px);
            transform: rotate(26deg);
            animation: rayMove 5s ease-in-out infinite alternate;
        }

        .envelope-wrap {
            position: relative;
            z-index: 2;
            width: min(560px, 94vw);
            perspective: 1400px;
            text-align: center;
        }

        .envelope {
            position: relative;
            width: 100%;
            aspect-ratio: 1.55 / 1;
            cursor: pointer;
            filter: drop-shadow(0 28px 26px rgba(72, 46, 11, .3));
            outline: none;
        }

        .envelope:focus-visible {
            outline: 3px solid white;
            outline-offset: 10px;
        }

        .envelope-body {
            position: absolute;
            inset: 0;
            border-radius: 8px;
            overflow: hidden;
            background: linear-gradient(135deg, #fffdf8, #f1e3c1);
            border: 1px solid #d8bb76;
        }

        .envelope-body::before,
        .envelope-body::after {
            content: "";
            position: absolute;
            z-index: 3;
            width: 72%;
            height: 100%;
            top: 18%;
            background: linear-gradient(145deg, #f7edda, #e8d3a0);
            border: 1px solid rgba(169, 127, 54, .45);
        }

        .envelope-body::before {
            left: -26%;
            transform: rotate(31deg);
            transform-origin: right top;
        }

        .envelope-body::after {
            right: -26%;
            transform: rotate(-31deg);
            transform-origin: left top;
        }

        .envelope-letter {
            position: absolute;
            z-index: 2;
            width: 76%;
            left: 12%;
            bottom: 9%;
            height: 74%;
            padding: 28px 18px;
            background: #fffefa;
            border: 1px solid #dec48a;
            box-shadow: 0 4px 13px rgba(77, 52, 15, .13);
            transition: transform 1s cubic-bezier(.2, .8, .2, 1);
        }

        .envelope-flap {
            position: absolute;
            z-index: 5;
            top: 0;
            width: 0;
            height: 0;
            border-left: 50% solid transparent;
            border-right: 50% solid transparent;
            border-left-width: 280px;
            border-right-width: 280px;
            border-top: 172px solid #e8d3a0;
            transform-origin: top;
            transition: transform 1s cubic-bezier(.2, .8, .2, 1);
            filter: drop-shadow(0 1px 0 rgba(140, 101, 40, .25));
        }

        .envelope.opening .envelope-flap {
            transform: rotateX(178deg);
            z-index: 1;
        }

        .envelope.opening .envelope-letter {
            transform: translateY(-34%);
        }

        .wax-seal {
            position: absolute;
            z-index: 6;
            top: 52%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 58px;
            height: 58px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            color: #fff8de;
            background: radial-gradient(circle at 32% 28%, #ddc17c, #8d672e 72%);
            box-shadow: 0 5px 10px rgba(78, 51, 13, .24);
            transition: opacity .35s ease;
        }

        .envelope.opening .wax-seal {
            opacity: 0;
        }

        .page-shell {
            width: 100%;
            min-height: calc(100 * min(var(--vh, 1vh), 1vh));
            position: relative;
            overflow: hidden;
        }

        .page-shell::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            opacity: .38;
            background-image: radial-gradient(#c8a85d 1px, transparent 1px);
            background-size: 22px 22px;
            mask-image: linear-gradient(to bottom, black, transparent 82%);
        }

        .ornament-line {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 13px;
            color: var(--gold);
        }

        .ornament-line::before,
        .ornament-line::after {
            content: "";
            width: clamp(42px, 12vw, 126px);
            height: 1px;
            background: linear-gradient(to right, transparent, var(--gold));
        }

        .ornament-line::after {
            transform: scaleX(-1);
        }

        .national-pattern {
            background:
                linear-gradient(45deg, transparent 48%, rgba(183, 147, 74, .14) 49%, rgba(183, 147, 74, .14) 51%, transparent 52%),
