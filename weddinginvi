                opacity: .25;
            }

            50% {
                transform: scale(1.05);
                opacity: .6;
            }
        }

        @keyframes rayMove {
            from {
                transform: translateX(-80%) rotate(26deg);
                opacity: .3;
            }

            to {
                transform: translateX(250%) rotate(26deg);
                opacity: .9;
            }
        }

        @keyframes revealUp {
            from {
                opacity: 0;
                transform: translateY(22px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 600px) {
