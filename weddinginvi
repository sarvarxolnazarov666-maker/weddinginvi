    <script>
        const entryScreen = document.getElementById('entry-screen');
        const envelopeButton = document.getElementById('envelope-button');
        const openInvitation = document.getElementById('open-invitation');
        const closeInvitation = document.getElementById('close-invitation');

        function openEnvelope() {
            envelopeButton.classList.add('opening');
            window.setTimeout(() => {
                entryScreen.classList.add('is-open');
                document.getElementById('invitation-page').focus?.();
            }, 720);
        }

        function closeEnvelope() {
            entryScreen.classList.remove('is-open');
            envelopeButton.classList.remove('opening');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        envelopeButton.addEventListener('click', openEnvelope);
        openInvitation.addEventListener('click', openEnvelope);
        closeInvitation.addEventListener('click', closeEnvelope);

        document.addEventListener('DOMContentLoaded', function () {
            lucide.createIcons();
        });
    </script>

