            background-size: 20px 20px;
        }

        .invitation-card {
            position: relative;
            border: 1px solid var(--line);
            background: rgba(255, 254, 250, .9);
            box-shadow: 0 18px 55px rgba(103, 76, 29, .1);
        }

        .invitation-card::before {
            content: "";
            position: absolute;
            inset: 10px;
            pointer-events: none;
            border: 1px solid rgba(183, 147, 74, .24);
        }

        .photo-frame {
            padding: 9px;
            background: var(--paper);
            border: 1px solid rgba(183, 147, 74, .55);
            box-shadow: 0 18px 35px rgba(78, 55, 19, .14);
        }

        .photo-frame img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .detail-card {
            border: 1px solid rgba(183, 147, 74, .26);
            background: rgba(255, 255, 255, .78);
            box-shadow: 0 10px 28px rgba(85, 59, 18, .06);
        }

        .gold-icon {
            color: var(--deep-gold);
            background: #f7edd7;
            border: 1px solid #e0c785;
        }

        .reveal-up {
            animation: revealUp .8s both;
        }

        .delay-1 {
            animation-delay: .1s;
        }

        .delay-2 {
            animation-delay: .2s;
        }

        .delay-3 {
            animation-delay: .3s;
        }

        .map-button {
            box-shadow: 0 10px 20px rgba(133, 94, 31, .18);
        }

        @keyframes halo {

            0%,
            100% {
